APP_NAME=BookstoreLaravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=mybookstore
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

JWT_SIGNER_KEY=change-this-laravel-bookstore-secret-key
JWT_VALID_DURATION=360000
JWT_REFRESHABLE_DURATION=36000

APP_BOOTSTRAP_ADMIN_ENABLED=true
APP_BOOTSTRAP_ADMIN_EMAIL=admin@bookstore.local
APP_BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
APP_BOOTSTRAP_ADMIN_FULL_NAME="Administrator"

APP_PAYMENT_BANK_TRANSFER_BANK_ID=970418
APP_PAYMENT_BANK_TRANSFER_BANK_NAME="BIDV"
APP_PAYMENT_BANK_TRANSFER_ACCOUNT_NUMBER=8860383073
APP_PAYMENT_BANK_TRANSFER_ACCOUNT_HOLDER="TRINH DUY NAM"
APP_PAYMENT_BANK_TRANSFER_SESSION_EXPIRY_MINUTES=15

APP_PAYMENT_PAYOS_ENABLED=false
APP_PAYMENT_PAYOS_USE_FOR_BANK_TRANSFER=false
APP_PAYMENT_PAYOS_ENVIRONMENT=production
APP_PAYMENT_PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_PARTNER_CODE=
APP_PAYMENT_PAYOS_WEBHOOK_URL=
APP_PAYMENT_PAYOS_RETURN_URL_BASE=
APP_PAYMENT_PAYOS_CANCEL_URL_BASE=
APP_PAYMENT_PAYOS_EXPIRY_MINUTES=15
APP_PAYMENT_PAYOS_SYNC_ENABLED=true
APP_PAYMENT_PAYOS_SYNC_FIXED_DELAY_MS=30000
APP_PAYMENT_PAYOS_SYNC_BATCH_SIZE=25
APP_PAYMENT_PAYOS_CANCEL_ON_ORDER_CANCEL=true

CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
